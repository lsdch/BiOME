{
  "name": "@biome/client",
  "repository": {
    "type": "git",
    "url": "git+github.com:lsdch/BiOME.git"
  },
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "pnpm run --silent gen-client && vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "pnpm gen-client && vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "gen-client": "bash scripts/gen-client.sh"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@hey-api/openapi-ts": "^0.90.10",
    "@mdi/font": "^7.4.47",
    "@stoplight/elements": "^9.0.16",
    "@tanstack/vue-query": "^5.96.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vueuse/components": "^14.2.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/router": "^14.2.1",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "d3-scale": "^4.0.2",
    "echarts": "^6.0.0",
    "flat": "^6.0.1",
    "fuzzysort": "^3.1.0",
    "hsluv": "^1.0.1",
    "http-status-codes": "^2.3.0",
    "leaflet": "^1.9.4",
    "leaflet.fullscreen": "^5.3.1",
    "luxon": "^3.7.2",
    "maska": "^3.2.0",
    "mime": "^4.1.0",
    "moment": "^2.30.1",
    "papaparse": "^5.5.3",
    "pinia": "^3.0.4",
    "stream-browserify": "^3.0.0",
    "uuid": "^13.0.0",
    "vue": "^3.5.32",
    "vue-advanced-cropper": "^2.8.9",
    "vue-component-type-helpers": "^3.2.6",
    "vue-debounce": "^5.0.1",
    "vue-echarts": "^8.0.1",
    "vue-leaflet-hexbin": "^0.2.2",
    "vue-leaflet-markercluster": "^0.6.1",
    "vue-router": "^4.6.4",
    "vuetify": "^3.12.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/d3-scale": "^4.0.9",
    "@types/dagre": "^0.7.54",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^27.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.fullscreen": "^3.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.2",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "cypress": "^15.13.0",
    "eslint": "^9.39.4",
    "eslint-plugin-cypress": "^5.3.0",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^27.4.0",
    "less": "^4.6.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.99.0",
    "start-server-and-test": "^2.1.5",
    "ts-toolbelt": "^9.6.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-mkcert": "^1.17.10",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-plugin-watch-and-run": "^1.8.0",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.6"
  }
}