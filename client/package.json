    "@deck.gl/mapbox": "^9.3.10",
    "@deck.gl/widgets": "^9.3.10",
    "@hey-api/openapi-ts": "^0.99.0",
    "@mdi/font": "^7.4.47",
    "@stoplight/elements": "^9.0.24",
    "@tanstack/vue-query": "^5.101.4",
