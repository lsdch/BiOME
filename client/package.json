    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "echarts": "^6.1.0",
    "flat": "^6.0.1",
    "fuzzysort": "^4.0.2",
    "h3-js": "^4.5.0",
    "hsluv": "^1.0.2",
