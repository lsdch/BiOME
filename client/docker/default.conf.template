server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    # Let the backend enforce upload limits for scientific source files.
    client_max_body_size 0;

    # Keep the original URI, including /api and /assets, when proxying.
    location ~ ^/(api(/|$)|assets$) {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite uses /assets too; its generated files take priority over the backend.
    location /assets/ {
        try_files $uri @backend_assets;
    }

    location @backend_assets {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
