
module seq {
  type Gene extending default::Vocabulary, default::Auditable {
    required motu: bool {
      default := false;
    }; # TODO : discuss with Florian
  }

  function geneByCode(code: str) -> Gene {
    using (
      select assert_exists(
        Gene filter .code = code,
        message := "Failed to find gene with code: " ++ code
      )
    );
  };


  abstract type Sequence extending default::Auditable, default::CodeIdentifier {

    # Optional human readable label; use NCBI 'DEFINITION' field when applicable
    label: str;

    # Actual sequence in FASTA format
    sequence: str;

    required gene: Gene;
    comments: str;

    legacy: tuple<id: int32, code: str, alignment_code: str> {
      annotation description := "Legacy identifiers for retrocompatibility with data stored in GOTIT.";
    };

    required is_identifying: bool {
      annotation description := "Whether this sequence should be used as the reference for the identification of the specimen";
      default := false
    };

    multi referenced_in: references::SeqReference {
      constraint exclusive;
      on target delete allow;
    };

    required category := (.__type__.name);

  }

  type AssembledSequence extending Sequence {
    required alignment_code: str { constraint exclusive };

    # required identification: occurrence::Identification;

    required multi assembled_by: str;
    multi chromatograms: sequencing::Chromatogram;
    required specimen: samples::Specimen;
  }

  # scalar type ExtSeqOrigin extending enum<Lab, PersCom, DB>;

  function generate_ext_seq_code(seq: ExternalSequence) -> str {
    using (
      with suffix := (
        # if seq.origin = ExtSeqOrigin.Lab then "lab"
        # else if seq.origin = ExtSeqOrigin.PersCom then "perscom"
        # else (
        select array_join(array_agg(seq.referenced_in.code), "|")
        # )
      )
      select
        taxonomy::taxon_code(seq.biomat.identification.taxon) ++
        "[" ++ events::sampling_code(seq.biomat.sampling) ++ "]" ++
        (seq.specimen_identifier ?? 'unknown') ++
        "|" ++ seq.gene.code ++
        (if suffix != "" then "|" ++ suffix else "")
    );
  };

  type ExternalSequence extending Sequence {

    required biomat: occurrence::Occurrence {
      on target delete delete source;
    };

    overloaded required code: str {
      constraint exclusive;
      rewrite update using (
        select generate_ext_seq_code(__subject__)
      );
    }

    # required origin: ExtSeqOrigin;

    # 🚧 enforce required references when origin = DB in the application layer
    # the following statement is not supported by Gel
    # constraint expression on (.has_references) except (.origin != ExtSeqOrigin.DB);

    required specimen_identifier: str {
      annotation description := "An identifier for the organism from which the sequence was produced, provided in the original source";
      constraint min_len_value(1);
    };
  }


  # function insert_external_seq(biomat: occurrence::Occurrence, data: json) -> ExternalSequence {
  #   using (
  #     insert ExternalSequence {
  #       biomat := biomat,
  #       code := <str>data['code'],
  #       label := <str>json_get(data, 'label'),
  #       sequence := <str>json_get(data, 'sequence'),
  #       gene := seq::geneByCode(<str>data['gene']),
  #       legacy := <tuple<id: int32, code: str, alignment_code: str>>json_get(data, 'legacy'),
  #       # origin := <seq::ExtSeqOrigin>json_get(data, 'origin'),
  #       referenced_in := (
  #         for ref in json_array_unpack(json_get(data, 'referenced_in'))
  #         insert references::SeqReference {
  #           db := references::dataSourceByCode(<str>ref['db']),
  #           accession := <str>ref['accession'],
  #         }
  #       ),
  #       specimen_identifier := <str>json_get(data, 'specimen_identifier'),
  #     }
  #   )
  # }

  alias GenericSequenceWithDetails := (
    select Sequence {
      required occurrence := assert_exists(
        (
          select occurrence::Occurrence
          filter .id = (Sequence[is AssembledSequence].specimen.biomat.id ?? Sequence[is ExternalSequence].biomat.id)
        ),
        message := "Failed to find upstream occurrence for seq::Sequence subtype"
      ),
      required identification := assert_exists(
        ([is AssembledSequence].specimen.biomat.identification ?? [is ExternalSequence].biomat.identification),
        message := "Failed to find identification for seq::Sequence subtype"
      ),
      required specimen_identifier := assert_exists([is AssembledSequence].specimen.code ?? [is ExternalSequence].specimen_identifier),
      internal := [is AssembledSequence] {
        alignment_code,
        assembled_by,
        chromatograms,
        specimen
      },
    }
  );
}





























