module occurrence {

  scalar type IdentificationQualifier extending enum<CF, AFF>;

  type Identification extending default::Auditable {
    required taxon: taxonomy::Taxon;

    identified_by: people::Person; # might be unknown

    identified_on: tuple<date: datetime, precision: date::DatePrecision>{
      rewrite insert, update using (
        (date := date::rewrite_date(.identified_on), precision :=.identified_on.precision)
      )
    };

    qualifier: IdentificationQualifier {
      annotation description := "Identification qualifier, e.g. 'cf.' or 'aff.'";
    };
  }

  scalar type OccurrenceCategory extending enum<Internal, External>;

  function occurrence_code(taxon: taxonomy::Taxon, sampling: events::Sampling) -> str {
    using ( taxonomy::taxon_code(taxon) ++ "[" ++ events::sampling_code(sampling) ++ "]" )
  };

  # Occurrences are reports of the presence of a taxon at a specific location and time.
  abstract type Occurrence extending default::Auditable, default::CodeIdentifier {

    required sampling: events::Sampling;
    required identification: Identification {
      constraint exclusive;
      on source delete delete target;
    };

    overloaded required code : str {
      constraint exclusive;
      annotation description := "Format like 'taxon_short_code[sampling_code]'";
      rewrite update using (
        if __specified__.code then .code # allow manual overwrite
        else occurrence_code(.identification.taxon, .sampling)
      );

      # 🚧 unsupported feature for now
      # > error: default expression cannot refer to links of inserted object
      # > this is a tempory implementation restriction
      # 🔗 see also: https://github.com/geldata/gel/issues/7384
      # -----
      # default := gen_occurrence_code(.identification, .sampling)
      # rewrite insert, update using (
      #   if re_test(r'^\d+$', .code)  then (
      #     .identification.taxon.code ++ "|" ++ events::event_code(.sampling.event)
      #   )
      #   else .code
      # );
    };

    required category := (
      assert_exists((
          if __source__ is InternalBioMat then OccurrenceCategory.Internal
          else if __source__ is ExternalBioMat then OccurrenceCategory.External
          else <OccurrenceCategory>{}
        ),
        message:= "Occurrence category for subtype " ++ __source__.__type__.name ++ " is undefined"
      )
    );

    # Defines whether this occurrence is the first scientific description of
    # the taxon
    required is_type: bool {
      default := false;
    };

    comments: str;

    access policy allow_insert_update allow all;
    access policy no_duplicated_taxon_in_same_sampling
      deny insert, update
      using (
        with
          id := .id,
          taxon := .identification.taxon,
        select exists (select .sampling.occurrences filter .id != id and .identification.taxon = taxon)
      ) {
        errmessage := 'Another occurrence with the same taxon already exists for this sampling event.';
      };
    # error: constraints cannot contain paths with more than one hop
    # constraint exclusive on ((.sampling, .identification.taxon));
  }

  type InternalBioMat extending Occurrence {
    # multi link content := .<biomat[is samples::Sample];
    multi link specimens := .<biomat[is samples::Specimen];
    multi link bundles := .<biomat[is samples::BundledSpecimens];

    required has_sequences := (exists .specimens.sequences);

    required is_homogenous := (
      select count(distinct .specimens.identification.taxon) <= 1
    );

    required is_congruent := (
      select assert_exists(
        .is_homogenous and (
          (not exists .specimens) or
          .identification.taxon in (
            assert_single(
              distinct .specimens.identification.taxon,
              message := "BioMaterial is marked as homogenous, yet specimens have identification mismatch. UUID: " ++ <str>.id
            ))
        )
      )
    );

    # Molecular identification, if available and homogenous
    single seq_consensus := (
      select (
        if .is_homogenous then
          assert_single(
            distinct .specimens.identification.taxon,
            message := "BioMaterial is marked as homogenous, yet specimens have identification mismatch. UUID: " ++ <str>.id
          )
        else {}
      )
    );
  }

  function insert_internal_biomat(sampling: events::Sampling, data: json) -> InternalBioMat {
    using (
      with
        identification := data['identification'],
        taxon := taxonomy::taxonByName(<str>identification['taxon']),
      insert InternalBioMat {
        sampling := sampling,
        code := <str>json_get(data, 'code') ?? occurrence::occurrence_code(taxon, sampling),
        identification := (
          insert occurrence::Identification {
            taxon := taxon,
            identified_by := people::personByAlias(<str>identification['identified_by']),
            identified_on := date::from_json_with_precision(identification['identified_on']),
          }
        ),
        is_type := <bool>json_get(data, 'is_type'),
        comments := <str>json_get(data, 'comments'),
      }
    )
  };

  scalar type QuantityType extending enum<One, Several, Ten, Tens, Hundred>;

  type ExternalBioMat extending Occurrence {
    multi sources: references::DataSource;
    external_link: str; # link to original database

    in_collection: str; # name of a collection where the specimen can be found
    multi item_vouchers: str; # specimen identifier(s) within the collection

    quantity: QuantityType;
    content_description: str;


    multi published_in: references::Article;

    original_taxon: str {
      annotation description := "The verbatim identification provided in the original source.";
    };

    required has_sequences := exists .sequences;
    multi sequences := .<biomat[is seq::ExternalSequence];
  }

  function externalBiomatByCode(code: optional str) -> ExternalBioMat {
    using (
      select assert_exists(
        ExternalBioMat filter .code = code,
        message := "Failed to find external biomaterial with code: " ++ code
      )
    );
  };


  function insert_external_biomat(sampling: events::Sampling, data: json) -> ExternalBioMat {
    using (
      with
        identification := data['identification'],
        taxon := taxonomy::taxonByName(<str>identification['taxon']),
      insert ExternalBioMat {
        sampling := sampling,
        code := <str>json_get(data, 'code') ?? occurrence::occurrence_code(taxon, sampling),
        sources := (
          select references::DataSource
          filter .code in <str>json_array_unpack(json_get(data, 'sources'))
        ),
        external_link := <str>json_get(data, 'external_link'),
        original_taxon := <str>json_get(data, 'original_taxon'),
        quantity := <occurrence::QuantityType>json_get(data, 'quantity'),
        content_description := <str>json_get(data, 'content_description'),
        in_collection := <str>json_get(data, 'collection'),
        item_vouchers := <str>json_array_unpack(json_get(data, 'item_vouchers')),
        comments := <str>json_get(data, 'comments'),
        published_in := (
          select distinct references::Article
          filter .code in <str>json_array_unpack(json_get(data, 'published_in'))
        ),
        identification := (
          insert occurrence::Identification {
            taxon := taxon,
            identified_by := people::personByAlias(<str>json_get(identification, 'identified_by')),
            identified_on := date::from_json_with_precision(json_get(identification, 'identified_on')),
          }
        ),
        is_type := <bool>json_get(data, 'is_type') ?? false,
      }
    )
  };


  alias OccurrenceWithType := (
    select Occurrence {
      required has_sequences := (
        [is InternalBioMat].has_sequences ?? [is ExternalBioMat].has_sequences ?? false
      ),
      internal := [is InternalBioMat]{
        is_homogenous,
        is_congruent,
        seq_consensus
      },
      external:= [is ExternalBioMat]{
        sequences,
        published_in,
        original_taxon,
        external_link,
        in_collection,
        item_vouchers,
        quantity,
        content_description,
      }
    }
  )
}
