module occurrence {

  type Identification extending default::Auditable {
    required taxon: taxonomy::Taxon;

    identified_by: people::Person;

    identified_on: tuple<date: datetime, precision: date::DatePrecision>{
      rewrite insert, update using (
        (date := date::rewrite_date(.identified_on), precision :=.identified_on.precision)
      )
    };

    required confer: bool {
      default := false;
    };

    addendum: str {
      annotation description := "Additional information about the identification, e.g. 'group venustus'.";
    };
  }

  function occurrence_code(taxon: taxonomy::Taxon, sampling_code: str) -> str {
    using ( taxonomy::taxon_code(taxon) ++ "[" ++ sampling_code ++ "]" )
  };

  scalar type TypeStatus extending enum<Holotype, Neotype, Topotype>;

  # Occurrences are reports of the presence of a taxon at a specific location and time.
  type Occurrence extending default::Auditable, default::CodeIdentifier {

    multi datasets: datasets::OccurrenceDataset {
      on target delete allow;
      on source delete allow;
    };
    required sampling: events::Sampling {
      on target delete delete source;
    };
    required identification: Identification {
      constraint exclusive;
      on source delete delete target;
    };

    overloaded required code : str {
      constraint exclusive;
      annotation description := "Format like 'taxon_short_code[sampling_code]'";

      # 🚧 unsupported feature for now
      # > error: default expression cannot refer to links of inserted object
      # > this is a tempory implementation restriction
      # 🔗 see also: https://github.com/geldata/gel/issues/7384
      # -----
      # default := gen_occurrence_code(.identification, .sampling)
      # rewrite insert, update using (
      #   if re_test(r'^\d+$', .code)  then (
      #     .identification.taxon.code ++ "|" ++ events::event_code(.sampling.event)
      #   )
      #   else .code
      # );
    };

    # Defines whether this occurrence is the first scientific description of
    # the taxon
    type_status : TypeStatus;

    comments: str;

    multi sources: references::DataSource;

    multi collections: references::Collection {
      vouchers: array<str>;
    };

    # in_collection: str; # name of a collection where the specimen can be found
    # multi item_vouchers: str; # specimen identifier(s) within the collection

    multi published_in: references::Article;
    original_taxon: str {
      annotation description := "The verbatim identification provided in the original source.";
    };

    quantity: tuple<lower: int32, upper: int32> {
      annotation description := "The number of specimens reported in this occurrence.";
    };
    content_description: str;

    multi link specimens := .<biomat[is samples::Specimen];
    multi link bundles := .<biomat[is samples::BundledSpecimens];

    multi sequences := .<biomat[is seq::ExternalSequence];
    required has_sequences := (exists .sequences);

    access policy allow_insert_update allow all;
    access policy no_duplicated_taxon_in_same_sampling
      deny insert, update
      using (
        with
          id := .id,
          taxon := .identification.taxon,
        select exists (select .sampling.occurrences filter .id != id and .identification.taxon = taxon)
      ) {
        errmessage := 'Another occurrence with the same taxon already exists for this sampling event.';
      };
    # error: constraints cannot contain paths with more than one hop
    # constraint exclusive on ((.sampling, .identification.taxon));
  }
}
